<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WPF has no tray icon, so we borrow NotifyIcon from Windows Forms -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ShaderWallApp</RootNamespace>
    <AssemblyName>ShaderWall</AssemblyName>
    <ApplicationIcon>Assets\ShaderWall.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Don't import Windows Forms names everywhere: they clash with WPF's (Button, MessageBox...) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShaderWall.Core\ShaderWall.Core.csproj" />
    <!-- Build the engine first, but don't load it as a library: we copy it into engine\ below -->
    <ProjectReference Include="..\ShaderWall.Engine\ShaderWall.Engine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ShaderWall.ico" />
  </ItemGroup>

  <!-- After building the app, copy the engine (and everything it needs) into our own engine\ folder,
       exactly where an installed copy of ShaderWall will have it -->
  <Target Name="CopyEngine" AfterTargets="Build">
    <ItemGroup>
      <EngineFiles Include="..\ShaderWall.Engine\bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(EngineFiles)"
          DestinationFiles="@(EngineFiles->'$(OutDir)engine\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
