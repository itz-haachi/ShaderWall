<Window x:Class="ShaderWallApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="ShaderWall" Width="1500" Height="900" MinWidth="1180" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#111111"
        Icon="Assets/ShaderWall.ico">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ============ Buttons ============ -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111111"/>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#111111"/>
        </Style>
        <!-- Text-only button -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Sidebar navigation (RadioButtons: only one can be selected) ============ -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Foreground" Value="#3A3A3A"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E2E2"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Segmented control (From URL / Paste code / From file, FPS cap) ============ -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#3A3A3A"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Editor tabs (Image / Common) ============ -->
        <!-- ============ Library filter chips ============ -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Filter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#3A3A3A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="34" Padding="14,0" CornerRadius="17" BorderBrush="#E2E2E2" BorderThickness="1" Background="White">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F4F4F4"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#111111"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#111111"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EdTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Editor"/>
            <Setter Property="Foreground" Value="#6B6B6B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="18,10" Background="Transparent" BorderBrush="#E2E2E2" BorderThickness="0,0,1,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ On/off switch (a restyled CheckBox) ============ -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="Root" Width="42" Height="24" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="12" Background="#D4D4D4"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#111111"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Code editor text boxes ============ -->
        <Style x:Key="Code" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ============ Settings panels and rows ============ -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E2E2E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,6,20,6"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E2E2E2"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,13"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#6B6B6B"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#6B6B6B"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Background="#F4F4F4" BorderBrush="#E2E2E2" BorderThickness="0,0,1,0" Padding="12,18">
            <DockPanel>
                <!-- Status card -->
                <Border DockPanel.Dock="Bottom" Background="#111111" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CardDot" Width="8" Height="8" Fill="White" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="CardTitle" Text="Not running" Foreground="White" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                        <TextBlock x:Name="CardShader" Text="Pick a shader to start" Foreground="#BDBDBD" FontSize="12"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <DockPanel x:Name="CardActions" Margin="0,4,0,0" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="CardPause" Content="Pause" Style="{StaticResource LinkBtn}" Foreground="White"
                                        FontSize="12" Click="CardPause_Click"/>
                                <Button Content="Stop" Style="{StaticResource LinkBtn}" Foreground="White" FontSize="12"
                                        Margin="12,0,0,0" Click="CardStop_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CardInfo" Foreground="#BDBDBD" FontSize="12"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel>
                    <RadioButton x:Name="NavAdd" Content="Add shader" Tag="&#xE710;" Style="{StaticResource Nav}" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLibrary" Content="Library" Tag="&#xF0E2;" Style="{StaticResource Nav}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDisplays" Content="Displays" Tag="&#xE7F4;" Style="{StaticResource Nav}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="Settings" Tag="&#xE713;" Style="{StaticResource Nav}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Content="About" Tag="&#xE946;" Style="{StaticResource Nav}" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== PAGES (one visible at a time) ===================== -->
        <Grid Grid.Column="1">

            <!-- ========== ADD SHADER ========== -->
            <Grid x:Name="AddPage" Margin="36,28,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Add a shader" Style="{StaticResource PageTitle}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource PageSub}"
                           Text="Paste a Shadertoy link or code. ShaderWall checks it and shows a live native preview."/>

                <Border Grid.Row="2" Background="#ECECEC" CornerRadius="9" Padding="3" HorizontalAlignment="Left" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SegUrl" Content="From URL" GroupName="Source" Style="{StaticResource Seg}" Checked="Source_Checked"/>
                        <RadioButton x:Name="SegPaste" Content="Paste code" GroupName="Source" Style="{StaticResource Seg}" IsChecked="True" Checked="Source_Checked"/>
                        <RadioButton x:Name="SegFile" Content="From file" GroupName="Source" Style="{StaticResource Seg}" Checked="Source_Checked"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <!-- From URL -->
                    <Grid x:Name="UrlPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="#111111" BorderThickness="1.5" CornerRadius="10" Height="48" Padding="14,0">
                            <DockPanel>
                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" Foreground="#6B6B6B"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="UrlBox" BorderThickness="0" VerticalAlignment="Center" FontSize="15"
                                         Text="https://www.shadertoy.com/view/"/>
                            </DockPanel>
                        </Border>
                        <Button x:Name="FetchButton" Grid.Column="1" Style="{StaticResource Primary}" Height="48"
                                Margin="10,0,0,0" Click="Fetch_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Fetch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Paste code -->
                    <Border x:Name="PastePanel" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="12" Height="210">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#F4F4F4" BorderBrush="#E2E2E2" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Paste from clipboard" Style="{StaticResource LinkBtn}"
                                            Foreground="#6B6B6B" FontSize="13" Margin="0,0,16,0" Click="PasteClipboard_Click"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="EdImage" Content="Image" Style="{StaticResource EdTab}" IsChecked="True" Checked="EditorTab_Checked"/>
                                        <RadioButton x:Name="EdCommon" Content="Common" Style="{StaticResource EdTab}" Checked="EditorTab_Checked"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Background="#F4F4F4" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,12,12" Padding="16,7">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Check + preview" Style="{StaticResource Primary}"
                                            Height="34" Padding="16,0" Click="Check_Click"/>
                                    <TextBlock x:Name="EditorStatus" VerticalAlignment="Center" FontSize="12.5" Foreground="#6B6B6B"
                                               Text="Paste a shader's Image tab, then press Check + preview"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <TextBox x:Name="ImageBox" Style="{StaticResource Code}"/>
                                <TextBox x:Name="CommonBox" Style="{StaticResource Code}" Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- From file -->
                    <Border x:Name="FilePanel" Visibility="Collapsed" BorderBrush="#CFCFCF" BorderThickness="1.5"
                            CornerRadius="12" Padding="18,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Choose a .glsl file" Style="{StaticResource Secondary}" Click="ChooseFile_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Load a shader saved on your PC" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FilePathText" Style="{StaticResource Desc}" Text="A common.glsl in the same folder is loaded too."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Preview (left) + details (right) -->
                <Grid Grid.Row="4" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="12" Background="Black" ClipToBounds="True" MinHeight="240">
                        <Grid>
                            <gl:GLWpfControl x:Name="Preview" Render="Preview_OnRender"/>

                            <Border Background="#99000000" CornerRadius="14" Padding="11,6" Margin="14"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="PreviewBadgeText" Text="Live preview · OpenGL" Foreground="White"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#8C000000" CornerRadius="10" Height="44" Margin="14" VerticalAlignment="Bottom" Padding="14,0">
                                <DockPanel>
                                    <Button Style="{StaticResource LinkBtn}" Foreground="White" Click="PreviewPause_Click" ToolTip="Pause / play the preview">
                                        <TextBlock x:Name="PreviewPauseIcon" Text="&#xE769;" FontFamily="{StaticResource Icons}" FontSize="14"/>
                                    </Button>
                                    <TextBlock x:Name="PreviewTimeText" Text="00:00.0" Foreground="White" FontSize="12.5"
                                               VerticalAlignment="Center" Margin="14,0"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="PreviewFpsText" Foreground="White" FontSize="12.5" Margin="14,0,0,0"/>
                                        <TextBlock x:Name="PreviewResText" Foreground="White" FontSize="12.5" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <Grid x:Name="TimeTrack" Height="4" VerticalAlignment="Center">
                                        <Border Background="#40FFFFFF" CornerRadius="2"/>
                                        <Border x:Name="TimeFill" Background="White" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Column="2">
                        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Save to library" Style="{StaticResource Secondary}" Click="SaveShader_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource Primary}" Click="SetWallpaper_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Set as wallpaper" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <TextBox x:Name="NameBox" FontSize="22" FontWeight="Bold" BorderThickness="0" Padding="0"
                                             Background="Transparent" TextChanged="NameBox_TextChanged"/>
                                    <TextBlock x:Name="NameHint" Text="Untitled shader" FontSize="22" FontWeight="Bold"
                                               Foreground="#B0B0B0" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock x:Name="MetaText" Text="Pasted code" Foreground="#6B6B6B" FontSize="13.5" Margin="0,4,0,0"/>

                                <ItemsControl x:Name="TagsList" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111111" CornerRadius="12" Padding="10,5" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="COMPATIBILITY CHECK" FontSize="11.5" FontWeight="Bold" Foreground="#6B6B6B" Margin="0,14,0,4"/>
                                <ItemsControl x:Name="ChecksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E2E2" BorderThickness="0,0,0,1" Padding="0,9">
                                                <DockPanel>
                                                    <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" VerticalAlignment="Top"
                                                            Margin="0,1,10,0" Background="{Binding CircleFill}" BorderBrush="{Binding CircleBorder}">
                                                        <TextBlock Text="{Binding Symbol}" Foreground="{Binding SymbolColor}" FontSize="11"
                                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Desc}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox x:Name="ErrorBox" Visibility="Collapsed" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                         MaxHeight="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="#F4F4F4" BorderThickness="0" Padding="8" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ========== LIBRARY ========== -->
            <Grid x:Name="LibraryPage" Margin="36,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" VerticalAlignment="Center" Click="GoToAdd_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Add shader" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Library" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="LibraryCountText" Style="{StaticResource PageSub}"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
                    <Border Width="340" Height="42" Background="#F4F4F4" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="9" Padding="12,0">
                        <DockPanel>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="#6B6B6B"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Grid VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchHint" Text="Search shaders" Foreground="#9A9A9A" IsHitTestVisible="False" Margin="2,0,0,0"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <RadioButton x:Name="FilterAll" Content="All" Style="{StaticResource Chip}" Margin="10,0,0,0"
                                 IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterFav" Content="Favourites" Style="{StaticResource Chip}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterAttention" Content="Needs attention" Style="{StaticResource Chip}" Checked="Filter_Checked"/>
                    <Border BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="17" Height="34" Padding="14,0" Margin="8,0,0,0" Opacity="0.5" ToolTip="Coming soon">
                        <TextBlock Text="Lightweight" FontSize="13" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <ListBox x:Name="LibraryList" Grid.Row="2" Margin="0,20,0,0" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LibraryList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,20,20" CornerRadius="12" Background="White" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#E2E2E2"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="#111111"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid Height="170">
                                        <Border CornerRadius="11,11,0,0" Background="Black" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                        <Border Visibility="{Binding ActiveVisibility}" Background="#99000000" CornerRadius="12"
                                                Padding="10,5" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Active" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Visibility="{Binding AttentionVisibility}" Background="White" CornerRadius="8"
                                                Padding="9,5" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding AttentionText}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DockPanel Margin="14,12">
                                        <Button DockPanel.Dock="Right" Content="•••" Style="{StaticResource LinkBtn}" Foreground="#6B6B6B"
                                                FontSize="16" Tag="{Binding}" Click="CardMenu_Click"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Tag="{Binding}" Click="Star_Click"
                                                Margin="0,0,14,0" ToolTip="Favourite">
                                            <TextBlock Text="{Binding StarGlyph}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#111111"/>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SavedText}" FontSize="12" Foreground="#6B6B6B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LibraryEmptyText" Grid.Row="2" Margin="0,30,0,0" Foreground="#6B6B6B" Visibility="Collapsed"
                           Text="No shaders saved yet. Add one, preview it, then press Save to library."/>
            </Grid>

            <!-- ========== DISPLAYS ========== -->
            <StackPanel x:Name="DisplaysPage" Margin="36,28" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Displays" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSub}" Text="The monitors Windows reports, and where the wallpaper runs."/>
                <StackPanel x:Name="DisplaysList" Margin="0,22,0,0"/>
                <TextBlock Style="{StaticResource Desc}" Margin="0,8,0,0"
                           Text="Coming soon: a different shader on each display."/>
            </StackPanel>

            <!-- ========== SETTINGS ========== -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,28">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Control how much of your GPU the wallpaper is allowed to use."/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Performance" Style="{StaticResource PanelTitle}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#ECECEC" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="Fps15" Content="15" GroupName="Fps" Style="{StaticResource Seg}" Padding="12,6" Checked="Fps_Checked"/>
                                                    <RadioButton x:Name="Fps30" Content="30" GroupName="Fps" Style="{StaticResource Seg}" Padding="12,6" Checked="Fps_Checked" IsChecked="True"/>
                                                    <RadioButton x:Name="Fps60" Content="60" GroupName="Fps" Style="{StaticResource Seg}" Padding="12,6" Checked="Fps_Checked"/>
                                                    <RadioButton x:Name="FpsMax" Content="Max" GroupName="Fps" Style="{StaticResource Seg}" Padding="12,6" Checked="Fps_Checked"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Frame-rate cap" FontWeight="Medium"/>
                                                <TextBlock Text="Lower = less GPU work. Remembered, and used the next time you set a wallpaper." Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Slider x:Name="ScaleSlider" Width="200" Minimum="25" Maximum="100" Value="100"
                                                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                        ValueChanged="ScaleSlider_ValueChanged"/>
                                                <TextBlock x:Name="ScaleText" Text="100%" Width="48" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Render scale" FontWeight="Medium"/>
                                                <TextBlock Text="Draw smaller, stretch to fill the screen. Changes the running wallpaper straight away." Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Slider x:Name="SpeedSlider" Width="200" Minimum="25" Maximum="300" Value="100"
                                                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                        ValueChanged="SpeedSlider_ValueChanged"/>
                                                <TextBlock x:Name="SpeedText" Text="1×" Width="48" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Shader speed" FontWeight="Medium"/>
                                                <TextBlock Text="How fast the animation plays. Changes the wallpaper and the preview straight away." Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Pause rendering when" Style="{StaticResource PanelTitle}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" IsHitTestVisible="False" ToolTip="Always on"/>
                                            <TextBlock Text="A window is maximized" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" IsHitTestVisible="False" ToolTip="Always on"/>
                                            <TextBlock Text="A fullscreen app or game is running" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsEnabled="False"/>
                                            <StackPanel>
                                                <TextBlock Text="Laptop is on battery"/>
                                                <TextBlock Text="Coming soon" Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsEnabled="False"/>
                                            <StackPanel>
                                                <TextBlock Text="The PC is locked"/>
                                                <TextBlock Text="Coming soon" Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Slideshow" Style="{StaticResource PanelTitle}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox x:Name="SleepSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                      Checked="SlideshowSwitch_Changed" Unchecked="SlideshowSwitch_Changed"/>
                                            <StackPanel>
                                                <TextBlock Text="New shader every time the PC goes to sleep"/>
                                                <TextBlock Text="The next shader in your library is ready when you wake it" Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox x:Name="LockSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                      Checked="SlideshowSwitch_Changed" Unchecked="SlideshowSwitch_Changed"/>
                                            <StackPanel>
                                                <TextBlock Text="Also when I lock the PC"/>
                                                <TextBlock Text="Quick to test: Win + L, then sign back in" Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <ComboBox x:Name="IntervalBox" DockPanel.Dock="Right" Width="110" VerticalAlignment="Center"
                                                      SelectionChanged="IntervalBox_SelectionChanged">
                                                <ComboBoxItem Content="Off" Tag="0"/>
                                                <ComboBoxItem Content="5 min" Tag="5"/>
                                                <ComboBoxItem Content="15 min" Tag="15"/>
                                                <ComboBoxItem Content="30 min" Tag="30"/>
                                                <ComboBoxItem Content="60 min" Tag="60"/>
                                            </ComboBox>
                                            <TextBlock Text="Also change every" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#ECECEC" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="OrderInOrder" Content="In order" GroupName="Order" Style="{StaticResource Seg}"
                                                                 Padding="12,6" IsChecked="True" Checked="Order_Checked"/>
                                                    <RadioButton x:Name="OrderRandom" Content="Random" GroupName="Order" Style="{StaticResource Seg}"
                                                                 Padding="12,6" Checked="Order_Checked"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Order" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Skip to next shader" Style="{StaticResource Secondary}"
                                                    Height="36" Padding="14,0" Click="SkipShader_Click"/>
                                            <TextBlock Text="Try it now" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Displays" Style="{StaticResource PanelTitle}"/>
                                    <StackPanel x:Name="SettingsDisplays" Margin="0,4,0,8"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="General" Style="{StaticResource PanelTitle}"/>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                      Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed"/>
                                            <StackPanel>
                                                <TextBlock Text="Start with Windows"/>
                                                <TextBlock Text="Starts in the tray and brings back your last wallpaper" Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" IsHitTestVisible="False" ToolTip="Always on"/>
                                            <StackPanel>
                                                <TextBlock Text="Restore my wallpaper on exit"/>
                                                <TextBlock Text="Puts your normal wallpaper back when ShaderWall closes" Style="{StaticResource Desc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <StackPanel>
                                            <TextBlock Text="Shadertoy API key"/>
                                            <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Desc}"/>
                                            <DockPanel Margin="0,10,0,4">
                                                <Button DockPanel.Dock="Right" Content="Save key" Style="{StaticResource Secondary}"
                                                        Height="36" Padding="14,0" Margin="8,0,0,0" Click="SaveKey_Click"/>
                                                <PasswordBox x:Name="ApiKeyBox" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CFCFCF"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== ABOUT ========== -->
            <Grid x:Name="AboutPage" Margin="36,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSub}" TextWrapping="Wrap"
                               Text="ShaderWall runs Shadertoy shaders natively on your GPU (OpenGL) as a live Windows wallpaper, with no browser in between."/>
                    <TextBlock Text="Built by Amulyapreet · C#, .NET, OpenTK, OpenGL, GLSL, Win32" Margin="0,14,0,0"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Desc}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LibraryPathText" Style="{StaticResource Desc}" Margin="0,2,0,0"/>
                    <TextBlock Text="ENGINE LOG" FontSize="11.5" FontWeight="Bold" Foreground="#6B6B6B" Margin="0,24,0,8"/>
                </StackPanel>
                <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5" Background="#F4F4F4"
                         BorderThickness="0" Padding="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Text="Messages from the wallpaper engine appear here."/>
            </Grid>
        </Grid>
    </Grid>
</Window>
