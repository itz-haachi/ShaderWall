<Window x:Class="ShaderWallApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="ShaderWall" Width="1280" Height="780" MinWidth="980" MinHeight="520"
        Background="White" FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <!-- Black button (main action) -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Outlined button -->
        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Code editor boxes -->
        <Style x:Key="Code" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title -->
            <RowDefinition Height="*"/>      <!-- code tabs -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
            <RowDefinition Height="170"/>    <!-- report -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Add a shader" FontSize="26" FontWeight="Bold" Foreground="#111111"/>
            <TextBlock Text="Paste a shader's Image tab (and its Common tab, if it has one) from Shadertoy."
                       Foreground="#6B6B6B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Code tabs (left) and live preview (right) -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="540"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" BorderBrush="#E2E2E2">
                <TabItem Header="Image" Padding="14,6">
                    <TextBox x:Name="ImageBox" Style="{StaticResource Code}"/>
                </TabItem>
                <TabItem Header="Common" Padding="14,6">
                    <TextBox x:Name="CommonBox" Style="{StaticResource Code}"/>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Column="2">
                <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#6B6B6B" Margin="0,4,0,8"/>
                <Border Background="Black" CornerRadius="8" Height="304" ClipToBounds="True">
                    <gl:GLWpfControl x:Name="Preview" Render="Preview_OnRender"/>
                </Border>
                <TextBlock x:Name="PreviewInfo" Text="Starting preview..." FontSize="12"
                           Foreground="#6B6B6B" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Buttons + settings -->
        <DockPanel Grid.Row="2" Margin="0,14,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Check + preview" Style="{StaticResource Secondary}" Click="Check_Click"/>
                <Button x:Name="StopButton" Content="Stop wallpaper" Style="{StaticResource Secondary}"
                        Click="Stop_Click" IsEnabled="False"/>
                <Button Content="Set as wallpaper" Style="{StaticResource Primary}" Click="SetWallpaper_Click"/>
            </StackPanel>
            <TextBlock Text="FPS cap" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FpsBox" Width="110" VerticalAlignment="Center" SelectedIndex="1">
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="30"/>
                <ComboBoxItem Content="60"/>
                <ComboBoxItem Content="Unlimited"/>
            </ComboBox>
            <TextBlock x:Name="StatusText" Text="Not running" VerticalAlignment="Center"
                       Margin="18,0,0,0" Foreground="#6B6B6B"/>
        </DockPanel>

        <!-- Report / engine output -->
        <TextBox x:Name="OutputBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                 Background="#F4F4F4" BorderThickness="0" Padding="10"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 Text="Paste a shader, then press Check + preview."/>
    </Grid>
</Window>
